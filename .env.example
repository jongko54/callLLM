CALL_LLM_PROVIDER_BASE_URL=http://127.0.0.1:18001
CALL_LLM_PROVIDER_API_KEY=local-dev-token
CALL_LLM_DEFAULT_MODEL=qwen3-8b-int4
CALL_LLM_PROVIDER_TOOL_CALLING=false
CALL_LLM_PERSISTENCE_BACKEND=sqlalchemy
# Leave CALL_LLM_DATABASE_URL unset to use the default local SQLite file under storage/
CALL_LLM_DATABASE_AUTO_CREATE=true
CALL_LLM_QUEUE_BACKEND=inline
CALL_LLM_REDIS_URL=redis://127.0.0.1:6379/0
